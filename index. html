<!DOCTYPE html>
<html>
<head>
    <title>Hospital Management System</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>🏥 Hospital Management System</h1>
    <p>Simple CRUD-Based Web Application</p>
</header>

<nav>
    <button onclick="showPage('dashboard')">Dashboard</button>
    <button onclick="showPage('patients')">Patients</button>
    <button onclick="showPage('add')">Add Patient</button>
</nav>

<div class="container">

    <section id="dashboard">
        <h2>Dashboard</h2>

        <div class="cards">
            <div class="card">
                <h3>Total Patients</h3>
                <p id="totalPatients">0</p>
            </div>

            <div class="card">
                <h3>Appointments</h3>
                <p id="appointments">0</p>
            </div>

            <div class="card">
                <h3>System Status</h3>
                <p>Active</p>
            </div>
        </div>
    </section>

    <section id="patients" class="hidden">
        <h2>Patient Records</h2>

        <input type="text"
               id="search"
               placeholder="Search patient..."
               onkeyup="displayPatients()">

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Disease</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="patientTable"></tbody>
        </table>
    </section>

    <section id="add" class="hidden">

        <h2>Add Patient</h2>

        <form id="patientForm">

            <input type="text" id="name"
                   placeholder="Patient Name" required>

            <input type="number" id="age"
                   placeholder="Age" required>

            <select id="gender" required>
                <option value="">Select Gender</option>
                <option>Male</option>
                <option>Female</option>
                <option>Other</option>
            </select>

            <input type="text" id="phone"
                   placeholder="Phone Number"
                   maxlength="10" required>

            <input type="text" id="disease"
                   placeholder="Disease" required>

            <input type="text" id="doctor"
                   placeholder="Doctor Name" required>

            <input type="date" id="date" required>

            <button type="submit">Add Patient</button>

        </form>

    </section>

</div>

<script src="script.js"></script>

</body>
